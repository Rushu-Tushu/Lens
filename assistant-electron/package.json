{
  "name": "lens-desktop",
  "productName": "Lens",
  "version": "2.0.0",
  "description": "The Anti-Recall: On-Demand, Zero-Surveillance, 100% Local Screen Intelligence",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "ai",
    "desktop-assistant",
    "ollama",
    "local-ai",
    "screen-intelligence",
    "privacy-first"
  ],
  "author": "Lens Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.2.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.lens.assistant",
    "productName": "Lens",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "lens-logo.png"
    }
  }
}
